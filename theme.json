{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#1B4D6E",
					"name": "Primary (Mediterranean Blue)"
				},
				{
					"slug": "primary-dark",
					"color": "#0F2E42",
					"name": "Primary Dark"
				},
				{
					"slug": "secondary",
					"color": "#D4A853",
					"name": "Secondary (Calabrian Gold)"
				},
				{
					"slug": "accent",
					"color": "#C75B39",
					"name": "Accent (Terracotta)"
				},
				{
					"slug": "neutral-light",
					"color": "#F5F1EB",
					"name": "Neutral Light (Sand)"
				},
				{
					"slug": "neutral",
					"color": "#E8E0D4",
					"name": "Neutral (Warm Gray)"
				},
				{
					"slug": "neutral-dark",
					"color": "#3D3A36",
					"name": "Neutral Dark"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#1A1A1A",
					"name": "Black"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Playfair Display', Georgia, serif",
					"slug": "heading",
					"name": "Heading",
					"fontFace": [
						{
							"fontFamily": "Playfair Display",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/PlayfairDisplay-VariableFont_wght.woff2"]
						},
						{
							"fontFamily": "Playfair Display",
							"fontWeight": "400 900",
							"fontStyle": "italic",
							"src": ["file:./assets/fonts/PlayfairDisplay-Italic-VariableFont_wght.woff2"]
						}
					]
				},
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"slug": "body",
					"name": "Body",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/Inter-VariableFont_wght.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "2.5rem", "name": "2X Large" },
				{ "slug": "hero", "size": "clamp(2.5rem, 5vw, 4.5rem)", "name": "Hero" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "XS" },
				{ "slug": "20", "size": "1rem", "name": "S" },
				{ "slug": "30", "size": "1.5rem", "name": "M" },
				{ "slug": "40", "size": "2.5rem", "name": "L" },
				{ "slug": "50", "size": "4rem", "name": "XL" },
				{ "slug": "60", "size": "6rem", "name": "2XL" }
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--neutral-dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--20)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--20)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--primary-dark)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--secondary)",
						"width": "4px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--neutral)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing Page", "postTypes": ["page"] },
		{ "name": "page-no-title", "title": "Page (No Title)", "postTypes": ["page"] }
	]
}
